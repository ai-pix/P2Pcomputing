{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/public/js",
    "rootDir": "./src/public/js"
  },
  "include": [
    "src/public/js/**/*.ts",
    "src/globals.d.ts"
  ]
}
