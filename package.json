{
  "name": "transcode-net",
  "version": "1.1.2-alpha",
  "description": "P2P Distributed Video Transcoding Platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "node copy-assets.js && tsc -p tsconfig.backend.json && tsc -p tsconfig.frontend.json",
    "start": "node dist/server/index.js",
    "dev": "tsc -p tsconfig.backend.json -w",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.transcodenet.app",
    "productName": "TranscodeNet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ai-pix",
        "repo": "P2Pcomputing"
      }
    ]
  }
}
